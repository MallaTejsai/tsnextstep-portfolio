# Web3Forms access key (https://web3forms.com — free tier, 250 submissions/month).
# Copy this file to `.env` and set your real key:
#
#   VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
#
# Then RESTART the dev server (Vite loads env vars at startup) or rebuild.
# The `.env` file is gitignored; the key is a client-side publish key that gets
# embedded into the built site — that is expected for Web3Forms.

VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
